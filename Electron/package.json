{
  "name": "the-shelf",
  "version": "1.0.0",
  "description": "The Shelf - A Personal Library",
  "main": "main.js",
  "scripts": {
    "start": "electron main.js",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.theshelf.library",
    "productName": "The Shelf",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../Backend",
        "to": "Backend",
        "filter": [
          "**/*",
          "!data/the_shelf.db"
        ]
      },
      {
        "from": "../Frontend",
        "to": "Frontend"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}